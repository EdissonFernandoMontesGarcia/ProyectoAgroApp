# Servidor HTTP
PORT=4000

# MongoDB (en EC2 usa MongoDB Atlas o una instancia administrada; no publiques MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=AgroApp
MONGO_USERS_COLLECTION=usuarios
MONGO_ORDERS_COLLECTION=ordenes

# Orígenes permitidos, separados por coma. Usa * solo durante desarrollo.
CORS_ORIGIN=*

# Secreto privado: nunca debe estar en Expo ni subirse a Git.
WOMPI_INTEGRITY_SECRET=
