# =============================================================================
#  ProyectoAgroApp — Plantilla de variables de entorno
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA commitees el archivo .env — está en .gitignore.
#
#  Reglas:
#   · EXPO_PUBLIC_*  →  disponible en el bundle del cliente (React Native)
#   · Sin prefijo    →  SOLO en scripts de servidor / backend (nunca al cliente)
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=AgroApp
EXPO_PUBLIC_CURRENCY=COP
EXPO_PUBLIC_DELIVERY_FEE=8000

# ── API ───────────────────────────────────────────────────────────────────────
# Descomenta UNA sola línea según el entorno:
#EXPO_PUBLIC_API_BASE_URL=https://tu-dominio-produccion.com
EXPO_PUBLIC_LOCAL_API_BASE_URL=http://TU_IP_LOCAL:4001

# ── MongoDB Data API ──────────────────────────────────────────────────────────
EXPO_PUBLIC_MONGODB_DATA_API_URL=
EXPO_PUBLIC_MONGODB_API_KEY=
EXPO_PUBLIC_MONGODB_DATA_SOURCE=Cluster0
EXPO_PUBLIC_MONGODB_DATABASE=agroapp
EXPO_PUBLIC_MONGODB_ORDERS_COLLECTION=ordenes

# ── Wompi ─────────────────────────────────────────────────────────────────────
# El ambiente (sandbox / production) se infiere del prefijo de la llave:
#   pub_test_...  →  sandbox   (pagos de prueba)
#   pub_prod_...  →  production (pagos reales)
# Obtén tus llaves en: Dashboard > Desarrolladores > Llaves
EXPO_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_REEMPLAZA_CON_TU_LLAVE

# Secreto de integridad → SIN prefijo EXPO_PUBLIC_ (nunca al cliente)
# Obtén tu secreto en: Dashboard > Desarrolladores > Secretos para integración técnica
WOMPI_INTEGRITY_SECRET=REEMPLAZA_CON_TU_SECRETO
